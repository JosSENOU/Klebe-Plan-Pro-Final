# Extrait à fusionner dans le .env du projet Laravel principal
# (ne pas écraser APP_KEY ni les variables déjà utilisées par Bilal pour WhatsApp)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klebe_plan_pro
DB_USERNAME=root
DB_PASSWORD=

# Dev local rapide sans serveur MySQL (optionnel, voir README > Choix technique) :
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# WhatsApp Cloud API (Meta) — tâche Bilal, voir config/services.php
# À récupérer sur developers.facebook.com > Meta for Developers > WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
